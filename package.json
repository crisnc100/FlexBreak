{
  "name": "flexbreak",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "export:mobile": "expo export --platform ios --platform android",
    "verify": "npm run lint && npm run type-check && npm test && npm run export:mobile",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "postinstall": "node scripts/patch-native-dependencies.mjs"
  },
