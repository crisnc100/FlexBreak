{
  "expo": {
    "name": "FlexBreak",
    "slug": "flexbreak",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/potentialLogo2.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cristianortega.flexbreak",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "FlexBreak uses your location to verify office worker eligibility when requested.",
        "NSMicrophoneUsageDescription": "FlexBreak needs access to your microphone for voice responses to the AI Wellness Coach.",
        "NSUserActivityTypes": [
          "OpenFlexCoachIntent"
        ],
        "NSSiriUsageDescription": "Use Siri to quickly open your AI Flex Coach for wellness check-ins."
      }
    },
    "android": {
      "package": "com.cristianortega.flexbreak",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO"
      ],
      "versionCode": 4
    },
    "web": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/potentialLogo2.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/sounds/ai_notification_1.mp3"
          ]
        }
      ],
      "./plugins/withSiriShortcuts.mjs",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-9873959079273159~5503902608"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "FlexBreak needs access to your microphone for voice responses to the AI Wellness Coach.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4776E6",
          "android": {
            "image": "./assets/images/potentialLogo2.png",
            "imageWidth": 100,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
          },
          "image": "./assets/images/launch-background.png"
        }
      ],
      "./plugins/withReleaseSigningGuard.mjs"
    ],
    "extra": {
      "eas": {
        "projectId": "e2f2f0ca-229d-4469-9de8-9f69b7f7a724"
      }
    },
    "owner": "crisnc100",
    "scheme": "flexbreak-app",
    "jsEngine": "hermes"
  }
}
