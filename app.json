{
  "expo": {
    "name": "FlexBreak",
    "slug": "flexbreak",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/potentialLogo2.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cristianortega.flexbreak",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "FlexBreak uses your location to verify office worker eligibility when requested.",
        "NSMicrophoneUsageDescription": "FlexBreak needs access to your microphone for voice responses to the AI Wellness Coach.",
        "NSUserActivityTypes": ["OpenFlexCoachIntent"],
        "NSSiriUsageDescription": "Use Siri to quickly open your AI Flex Coach for wellness check-ins."
      },
      "splash": {
        "xib": "./ios/FlexBreak/SplashScreen.storyboard"
      }
    },
    "android": {
      "package": "com.cristianortega.flexbreak",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO"
      ],
      "versionCode": 4,
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "web": {},
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/potentialLogo2.png",
          "color": "#ffffff",
          "sounds": ["./assets/sounds/AInotification1.mp3"]
        }
      ],
      "./plugins/withSiriShortcuts",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9873959079273159~5503902608",
          "iosAppId": "ca-app-pub-9873959079273159~5503902608"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2f2f0ca-229d-4469-9de8-9f69b7f7a724"
      }
    },
    "owner": "crisnc100",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e2f2f0ca-229d-4469-9de8-9f69b7f7a724"
    },
    "scheme": "flexbreak-app",
    "jsEngine": "hermes"
  }
}
