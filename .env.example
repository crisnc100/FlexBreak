# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# OpenRouter API (for AI Flex Coach)
OPENROUTER_API_KEY=your_openrouter_api_key_here
APP_URL=https://flexbreak.app

# Groq API (Backup for AI Flex Coach if OpenRouter fails)
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Firebase Service Account (store as base64 encoded string)
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_here

# Other API Keys
GOOGLE_MAPS_API_KEY=your_api_key_here
STRIPE_SECRET_KEY=your_stripe_key_here

# Voice Recognition (Google Cloud Speech-to-Text)
# Get your key from: https://console.cloud.google.com/apis/credentials
# 60 free minutes per month!
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here